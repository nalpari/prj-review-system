{
  "name": "prj-review-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pb:serve": "node scripts/pb.mjs serve",
    "pb:superuser": "node --env-file-if-exists=.env.local scripts/pb.mjs superuser",
    "pb:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "test": "node --test src/lib/*.test.ts",
    "test:rules": "node --env-file-if-exists=.env.local --test scripts/rules.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "pocketbase": "^0.28.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
