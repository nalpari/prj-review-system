# 로컬 환경변수 예시. 복사해서 .env.local로 쓴다(.env.local은 git에서 제외된다).
#   macOS / Linux:      cp .env.example .env.local
#   Windows PowerShell: Copy-Item .env.example .env.local
# Next.js 앱과 pnpm pb:superuser / pb:seed / test:rules가 .env.local을 읽는다.

# PocketBase 슈퍼유저. pnpm pb:superuser가 이 계정을 만들고, 서버는 이 계정으로만
# 리뷰 결과·실행 상태·댓글·이력을 쓴다. 로컬 개발용 값이며 공유 서버에서는 바꾼다.
PB_SUPERUSER_EMAIL=superuser@redline.local
PB_SUPERUSER_PASSWORD=redline-superuser-1

# PocketBase 주소. pnpm pb:serve는 http://127.0.0.1:8090에서 뜬다.
POCKETBASE_URL=http://127.0.0.1:8090

# 원격 저장소를 클론해 둘 서버 디렉터리. 비우면 프로젝트의 .data/repos를 쓴다.
# 비공개 저장소는 이 서버 계정의 SSH 키나 git credential helper로 인증한다.
# REPOS_DIR=/srv/redline/repos

# 리뷰 한 건의 실행 제한 시간(밀리초). 기본 20분. 리뷰는 이 서버에 로그인된 claude / codex CLI로 실행한다.
# REVIEW_TIMEOUT_MS=1200000
