      "html": "<button class=\"ds-btn-danger\">실행 취소</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 12px;border-radius:var(--radius-control,6px);font:600 13px/20px var(--font-sans,'Wanted Sans Variable',sans-serif);cursor:pointer;transition:background-color 150ms,color 150ms;background:#fff;color:#c4242a;border:1px solid rgba(196,36,42,.6);} .ds-btn-danger:hover{background:#fde9e7;} .ds-btn-danger:focus-visible{outline:2px solid #15171a;outline-offset:2px;}"
