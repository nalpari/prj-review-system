      "css": ".ds-nav{display:grid;gap:2px;width:208px;padding:12px;background:#f3f4f1;} .ds-nav-item{display:flex;align-items:center;gap:10px;height:32px;padding:0 8px;border-radius:6px;color:#15171a;font:400 14px/20px var(--font-sans,'Wanted Sans Variable',sans-serif);text-decoration:none;} .ds-nav-item span{flex:1;} .ds-nav-item small{font-size:12px;color:#555a53;font-variant-numeric:tabular-nums;} .ds-nav-item:hover{background:#e6e8e3;} .ds-nav-item.is-active{background:#e6e8e3;font-weight:600;} .ds-nav-item:focus-visible{outline:2px solid #15171a;outline-offset:2px;}"
