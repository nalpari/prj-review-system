    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "화면의 주 행동 하나. 잉크 덩어리.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M8 3v10M3 8h10\"/></svg>새 리뷰 요청</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 12px;border-radius:var(--radius-control,6px);font:600 13px/20px var(--font-sans,'Wanted Sans Variable',sans-serif);cursor:pointer;transition:background-color 150ms,color 150ms;background:#15171a;color:#fff;border:0;} .ds-btn-primary:hover{background:#2b2e33;} .ds-btn-primary:focus-visible{outline:2px solid #15171a;outline-offset:2px;} .ds-btn-primary:disabled{background:#6d7170;opacity:.7;cursor:not-allowed;}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "보조 행동. 흰 판과 컨트롤 테두리.",
      "html": "<button class=\"ds-btn-secondary\">적용</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 12px;border-radius:var(--radius-control,6px);font:600 13px/20px var(--font-sans,'Wanted Sans Variable',sans-serif);cursor:pointer;transition:background-color 150ms,color 150ms;background:#fff;color:#15171a;border:1px solid #c9cdc5;} .ds-btn-secondary:hover{background:#f8f9f6;} .ds-btn-secondary:focus-visible{outline:2px solid #15171a;outline-offset:2px;}"
    },
    {
